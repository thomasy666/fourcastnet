# config.env — single source of truth for the FourCastNet workflow.
# Usage (from repo root):  source config.env
# Every value marked TODO must be filled in from the cluster before running anything.

# ---------------------------------------------------------------------------
# Cluster (AI Makerspace) — TODO: fill in from Step 1 cluster facts
# ---------------------------------------------------------------------------
# sbatch reads these SBATCH_* env vars automatically, so the job scripts don't
# hardcode cluster names. Comment out ACCOUNT/QOS if the cluster doesn't need them.
export SBATCH_PARTITION="TODO"          # TODO: from `sinfo`
export SBATCH_ACCOUNT="TODO"            # TODO: from `sacctmgr show assoc user=$USER`
export SBATCH_QOS="TODO"                # TODO: from `sacctmgr show assoc user=$USER`
export SBATCH_GRES="TODO"               # TODO: e.g. gpu:1 or gpu:<type>:1, from `sinfo -o "%G"`

export MODULES="TODO"                   # TODO: space-separated, from `module avail` (conda + cuda)
export SCRATCH_DIR="TODO"               # TODO: large scratch/project storage path

# ---------------------------------------------------------------------------
# Software versions (pinned)
# ---------------------------------------------------------------------------
export PYTHON_VERSION="3.12"
export EARTH2STUDIO_VERSION="0.13.0"
export CONDA_ENV_NAME="fcn"

# ---------------------------------------------------------------------------
# Paths (derived from SCRATCH_DIR; large files live here, never in the repo)
# ---------------------------------------------------------------------------
export WORK_DIR="$SCRATCH_DIR/fourcastnet"
export DATA_DIR="$WORK_DIR/data"                       # ERA5 NetCDF written by prefetch.py
export EARTH2STUDIO_CACHE="$WORK_DIR/cache"
export EARTH2STUDIO_MODEL_CACHE="$WORK_DIR/cache/models"   # FCN checkpoint from NGC
export EARTH2STUDIO_DATA_CACHE="$WORK_DIR/cache/data"

# ---------------------------------------------------------------------------
# Run parameters
# ---------------------------------------------------------------------------
export MODEL="FCN"                                     # FourCastNet v1 (AFNO), 6-hour timestep
export INIT_TIMES="2023-01-01T00:00:00 2023-07-01T00:00:00"   # winter + summer
export NSTEPS=20                                       # 20 x 6 h = 120 h (5 days)
export SMOKE_NSTEPS=2                                  # 12 h, for the smoke job
export EVAL_VARS="z500 t850 t2m u10m"                  # variables saved + validated
export SEED=0
